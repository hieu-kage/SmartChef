# =================================================================
# SMARTCHEF ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Project Identity (Đổi tên này để chạy song song nhiều bản)
# Ví dụ: smartchef_dev, smartchef_prod, smartchef_test
COMPOSE_PROJECT_NAME=smartchef_test

# 2. API Keys & Models
GOOGLE_API_KEY=your_google_api_key_here
MODEL_NAME=gemini-3.1-flash-lite-preview

# 3. Database Configuration
POSTGRES_DB=smartchef_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# 4. Port Mapping (Đổi số bên trái nếu bị trùng cổng trên máy)
# [Host Port] : [Container Port]
API_PORT_EXT=8001
POSTGRES_PORT_EXT=5433
QDRANT_PORT_EXT=6334

# 5. LangSmith (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartchef
